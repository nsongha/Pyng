{
  "version": 2,
  "env": {
    "PYTHONPATH": "."
  },
  "rewrites": [
    { "source": "/api/checkins/:path*", "destination": "/api/checkins" },
    { "source": "/api/leave/:path*", "destination": "/api/leave" },
    { "source": "/qr(.*)", "destination": "/qr/index.html" },
    { "source": "/miniapp/(.*)", "destination": "/miniapp/dist/index.html" },
    { "source": "/miniapp", "destination": "/miniapp/dist/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/miniapp/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.telegram.org; frame-ancestors https://web.telegram.org https://desktop-app.telegram.org"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "ALLOW-FROM https://web.telegram.org" }
      ]
    }
  ]
}
