{
  "version": 2,
  "installCommand": "cd miniapp && npm install",
  "buildCommand": "cd miniapp && npx vite build && rm index.html",
  "outputDirectory": ".",
  "env": {
    "PYTHONPATH": "."
  },
  "rewrites": [
    { "source": "/api/checkins/:path*", "destination": "/api/checkins" },
    { "source": "/api/leave/:path*", "destination": "/api/leave" },
    { "source": "/qr(.*)", "destination": "/qr/index.html" },
    { "source": "/miniapp/assets/:path*", "destination": "/miniapp/dist/assets/:path*" },
    { "source": "/miniapp/:path((?!assets/).*)", "destination": "/miniapp/dist/index.html" },
    { "source": "/miniapp", "destination": "/miniapp/dist/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/miniapp/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
