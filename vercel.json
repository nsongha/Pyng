{
  "version": 2,
  "env": {
    "PYTHONPATH": "."
  },
  "rewrites": [
    { "source": "/qr(.*)", "destination": "/qr/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
